{
  "manifest_version": 3,
  "name": "AI Usage · ChatGPT",
  "version": "0.5.0",
  "description": "Local-only ChatGPT workload dashboard for prompts, thinking time, model usage, and estimated tokens.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "AI Usage · ChatGPT",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
